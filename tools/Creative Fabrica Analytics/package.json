{
  "name": "creative-fabrica-analytics",
  "version": "1.0.0",
  "description": "Cross-platform Playwright automation for Creative Fabrica stats collection & sync",
  "type": "module",
  "main": "src/cli.js",
  "scripts": {
    "auth": "node src/cli.js --auth",
    "stats": "node src/cli.js --stats",
    "stats:all": "node src/cli.js --stats --pages all",
    "check": "node src/cli.js --stats --restart",
    "recheck": "node src/cli.js --stats --pages all --restart",
    "scrape": "node src/cli.js --stats --no-analyze",
    "scrape:all": "node src/cli.js --stats --pages all --no-analyze",
    "update": "node src/cli.js --stats --incremental",
    "update:headless": "node src/cli.js --stats --incremental --headless",
    "analyze": "node src/cli.js --analyze",
    "analyzer": "node src/analyzer.js",
    "dashboard": "open dashboard/index.html",
    "build:dashboard": "node scripts/build-complete-dashboard.js",
    "sync": "node src/cli.js --stats --incremental --sync",
    "verify-stealth": "node src/cli.js --verify-stealth"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "playwright": "^1.50.1",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "liarjs": "^0.4.2"
  }
}
