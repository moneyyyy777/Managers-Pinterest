---
// src/pages/index.astro
import BaseLayout from "../layouts/BaseLayout.astro";
import CollectionCard from "../components/CollectionCard.astro";
import categories from "../data/categories.json";
import type { ImageMetadata } from "astro";

// Автоматически находим локальные обложки категорий из src/assets/category/
const localCategoryImages = import.meta.glob<{ default: ImageMetadata }>('../assets/category/*.{png,jpg,jpeg,webp}', { eager: true });

const getCategoryImage = (id: string, fallbackUrl: string) => {
	const matchedPath = Object.keys(localCategoryImages).find(path => {
		const filename = path.split('/').pop()?.split('.')[0];
		return filename === id;
	});
	return matchedPath ? localCategoryImages[matchedPath].default.src : fallbackUrl;
};
---

<BaseLayout 
	title="Artify Studio — Curated Digital Asset Archive & Design Intelligence"
	description="Discover handpicked collections of fonts, Procreate brushes, and SVG cut files with full commercial licenses."
>

<section class="container mx-auto px-4 py-10 sm:py-16 max-w-7xl">

	<!-- Hero Заголовок -->
	<div class="max-w-3xl mb-12 sm:mb-16">
		<div class="inline-flex items-center gap-2 text-[11px] font-mono font-medium uppercase tracking-widest text-[#FF4B26] bg-[#FF4B26]/10 px-3 py-1 rounded-md border border-[#FF4B26]/30">
			<span class="w-1.5 h-1.5 rounded-full bg-[#FF4B26] animate-pulse"></span>
			<span>ARCHIVE EDITION // 2026</span>
		</div>

		<h1 class="text-4xl sm:text-6xl font-display font-extrabold text-[#F7F7F8] mt-5 tracking-tight leading-[1.08]">
			The Curated Design Intelligence & Asset Archive
		</h1>

		<p class="mt-4 text-base sm:text-lg text-[#8E929B] leading-relaxed max-w-2xl">
			Handpicked fonts, Procreate brushes, patterns and SVG cut files with unlimited commercial licenses. Filtered for high-end client work and digital craftsmanship.
		</p>
	</div>

	<!-- Telegram Community Hub Card -->
	<div class="mb-14 rounded-xl border border-[#24262B] bg-[#141518] p-6 sm:p-8 flex flex-col md:flex-row md:items-center justify-between gap-6 relative overflow-hidden group">
		<div class="absolute -right-16 -top-16 w-64 h-64 bg-[#FF4B26]/5 rounded-full blur-3xl pointer-events-none"></div>
		
		<div class="max-w-xl z-10">
			<div class="flex items-center gap-2 mb-2 text-[#FF4B26] font-mono text-xs font-semibold uppercase tracking-wider">
				<span>✦</span>
				<span>TELEGRAM ARCHIVE COMMUNITY (~1,000 CREATORS)</span>
			</div>
			<h2 class="text-xl sm:text-2xl font-display font-bold text-[#F7F7F8] tracking-tight">
				Daily Curated Drops & Commercial License Passes
			</h2>
			<p class="mt-1.5 text-xs sm:text-sm text-[#8E929B] leading-relaxed">
				Join practicing art directors, illustrators and Etsy sellers. Get instant font pairing cheat sheets, private bundle drops and All Access promo rates ($4.99).
			</p>
		</div>

		<div class="z-10 shrink-0">
			<a 
				href="https://t.me/artify_archive" 
				target="_blank" 
				rel="noopener"
				class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-lg bg-[#FF4B26] hover:bg-[#FF6647] text-white font-mono font-bold text-xs uppercase tracking-wider shadow-lg shadow-[#FF4B26]/25 hover:shadow-[#FF4B26]/50 transition-all duration-200"
			>
				<span>Join Telegram Archive</span>
				<span>→</span>
			</a>
		</div>
	</div>

	<!-- Сетка главных Разделов -->
	<div class="grid gap-6 sm:gap-8 md:grid-cols-2 lg:grid-cols-3">
		{
			categories.map((category, index) => (
				<CollectionCard
					title={category.title}
					description={category.description}
					image={getCategoryImage(category.id, category.image)}
					category="Main Collection"
					count={category.count}
					href={category.href}
					priority={index < 4}
				/>
			))
		}
	</div>

</section>

</BaseLayout>