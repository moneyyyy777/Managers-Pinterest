---
// src/components/CollectionGrid.astro
import CollectionCard from "./CollectionCard.astro";

interface Props {
	title: string;
	description?: string;
	collections: any[];
}

const {
	title,
	description = "Handpicked creative collections for professional designers and crafters.",
	collections
} = Astro.props;
---

<section class="container mx-auto px-4 py-8 sm:py-12 max-w-7xl">

	<div class="max-w-3xl mb-10 sm:mb-14">
		<h1 class="text-4xl sm:text-5xl font-black text-white tracking-tight">
			{title}
		</h1>
		<p class="mt-3 text-neutral-400 text-sm sm:text-base leading-relaxed">
			{description}
		</p>
	</div>

	<div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
		{
			collections.map((item) => (
				<CollectionCard
					title={item.title}
					description={item.description}
					image={item.image}
					category={item.category}
					count={item.count}
					href={item.href}
				/>
			))
		}
	</div>

</section>