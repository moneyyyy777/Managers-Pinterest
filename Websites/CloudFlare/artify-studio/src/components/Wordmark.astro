---
interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---

<span class:list={['artify-wordmark', { light }]}>
  <img src="/images/artify-wordmark.webp" width="600" height="600" alt="Artify Studio" />
</span>

<style>
  .artify-wordmark {
    display: block;
    width: var(--wordmark-width, 8rem);
    aspect-ratio: 2 / 1;
    background: #100c12;
    mask-image: linear-gradient(#fff, #fff), url('/images/artify-wordmark.webp');
    mask-mode: alpha, luminance;
    mask-size: 100% 100%, 121% auto;
    mask-position: center, 50% 51.8%;
    mask-repeat: no-repeat;
    mask-composite: subtract;
  }

  .artify-wordmark.light { background: #fff; }

  .artify-wordmark img {
    width: 100%;
    height: 100%;
    opacity: 0;
  }
</style>
