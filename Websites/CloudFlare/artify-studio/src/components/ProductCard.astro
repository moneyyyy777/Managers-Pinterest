---
// src/components/ProductCard.astro
import { buildAffiliateUrl } from '../utils/build-affiliate-url.js';
import { optimizeImageUrl } from '../utils/image-optimizer.js';

interface Product {
	slug: string;
	title: string;
	author?: string;
	canonical?: string;
	image: string;
	description?: string;
	fullDescription?: string;
	gallery?: string[];
	license?: string;
}

interface Props {
	product: Product;
	campaign?: string;
	category?: string;
	priority?: boolean;
}

const { product, campaign = "", category = "", priority = false } = Astro.props;

const affiliateUrl = buildAffiliateUrl(
    product.canonical || product.slug, 
    campaign, 
    category
);

const rawImages = product.image ? [product.image] : [];

// 2. Добавляем остальные фото из галереи, исключая служебные прозрачные preview-файлы
if (product.gallery && product.gallery.length > 0) {
    for (const img of product.gallery) {
        if (img && img !== product.image && !img.includes('preview') && !rawImages.includes(img)) {
            rawImages.push(img);
        }
    }
}

const images = rawImages.map(img => ({
    url: optimizeImageUrl(img),
    fallback: img
}));
---

<div class="group flex flex-col rounded-xl border border-[#24262B] bg-[#141518] overflow-hidden transition duration-300 hover:border-[#FF4B26]/60 hover:shadow-2xl hover:shadow-[#FF4B26]/5">
	
	<!-- 1. КАРАУСЕЛЬ ФОТОГРАФИЙ (ТОЛЬКО ДЛЯ СВАЙПА И ПРОСМОТРА) -->
	<div class="relative aspect-[3/2] overflow-hidden bg-[#090A0C] group/carousel">
		<div class="flex h-full w-full overflow-x-auto snap-x snap-mandatory no-scrollbar scroll-smooth carousel-scroll-container">
			{images.map((imgItem, index) => {
				const isEager = index === 0 && priority;
				return (
					<a
						href={affiliateUrl}
						target="_blank"
						rel="nofollow sponsored"
						class="block h-full w-full flex-none snap-center relative bg-[#090A0C] cursor-pointer"
						title="Click to view on Creative Fabrica"
					>
						<img
							src={isEager ? imgItem.url : "data:image/gif;base64,R0lGODlhAQABAAD/ACwAAAAAAQABAAACADs="}
							data-src={!isEager ? imgItem.url : null}
							data-fallback={imgItem.fallback}
							onerror="if (this.dataset.fallback && this.src !== this.dataset.fallback) { this.src = this.dataset.fallback; }"
							alt={`${product.title} - photo ${index + 1}`}
							loading={isEager ? "eager" : "lazy"}
							decoding="async"
							fetchpriority={isEager ? "high" : "auto"}
							class="h-full w-full object-cover select-none lazy-gallery-img transition-opacity duration-300"
						/>
					</a>
				);
			})}
		</div>

		<!-- Кнопки навигации (показываем только на десктопе при наведении) -->
		{images.length > 1 && (
			<>
				<button type="button" class="carousel-prev absolute left-2 top-1/2 -translate-y-1/2 w-8 h-8 hidden md:flex items-center justify-center rounded-full bg-black/60 text-white opacity-0 group-hover/carousel:opacity-100 transition-opacity hover:bg-black/90 backdrop-blur-md z-10 border border-white/10" aria-label="Previous photo">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
				</button>
				<button type="button" class="carousel-next absolute right-2 top-1/2 -translate-y-1/2 w-8 h-8 hidden md:flex items-center justify-center rounded-full bg-black/60 text-white opacity-0 group-hover/carousel:opacity-100 transition-opacity hover:bg-black/90 backdrop-blur-md z-10 border border-white/10" aria-label="Next photo">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
				</button>
			</>
		)}

		<!-- Бейдж Лицензии -->
		<span class="absolute top-3 left-3 bg-[#090A0C]/90 backdrop-blur-md text-[#F7F7F8] text-[9px] font-mono font-medium px-2.5 py-1 rounded-md uppercase tracking-wider border border-[#24262B] select-none pointer-events-none flex items-center gap-1.5">
			<span class="w-1.5 h-1.5 rounded-full bg-[#FF4B26]"></span>
			<span>Commercial License Included</span>
		</span>

		<!-- Индикатор количества фото -->
		{images.length > 1 && (
			<div class="carousel-counter absolute bottom-3 right-3 bg-[#090A0C]/90 backdrop-blur-md text-[#8E929B] text-[10px] font-mono px-2 py-0.5 rounded border border-[#24262B] select-none pointer-events-none" data-total={images.length}>
				<span class="carousel-current text-[#F7F7F8]">1</span> / {images.length}
			</div>
		)}
	</div>

	<!-- 2. ВЕСЬ НИЖНИЙ БЛОК — ЭТО ЕДИНАЯ КЛИКАБЕЛЬНАЯ ПАРТНЕРСКАЯ ССЫЛКА -->
	<a
		href={affiliateUrl}
		target="_blank"
		rel="nofollow sponsored"
		class="p-5 flex flex-col justify-between flex-1 cursor-pointer group/link hover:bg-white/[0.015] transition"
	>
		<div>
			<h3 class="text-base font-display font-bold text-[#F7F7F8] tracking-tight leading-snug group-hover/link:text-[#FF4B26] transition">
				{product.title}
			</h3>

			<p class="mt-2 text-xs text-[#8E929B] leading-relaxed line-clamp-3">
				{product.description || "Curated asset for creative and commercial projects · Windows, Mac, iPad · Commercial license included ✓"}
			</p>
		</div>

		<!-- 3. ШВЕЙЦАРСКАЯ АКЦЕНТНАЯ КНОПКА (ВНУТРИ ССЫЛКИ ДЛЯ МАКСИМАЛЬНОЙ КОНВЕРСИИ) -->
		<div class="mt-5 relative">
			<span
				class="w-full bg-[#FF4B26] group-hover/link:bg-[#FF6647] text-white font-mono font-bold text-xs py-3 px-4 rounded-lg text-center tracking-wider uppercase transition-all duration-300 ease-out block shadow-lg shadow-[#FF4B26]/20 group-hover/link:shadow-[#FF4B26]/40 group-hover/link:scale-[1.01] relative overflow-hidden btn-sparkle"
			>
				Download Asset
			</span>
		</div>
	</a>

</div>
<script>
    function initCarousels() {
        const carousels = document.querySelectorAll('.group\\/carousel');
        carousels.forEach(carousel => {
            const container = carousel.querySelector('.carousel-scroll-container');
            const prevBtn = carousel.querySelector('.carousel-prev');
            const nextBtn = carousel.querySelector('.carousel-next');
            const currentCounter = carousel.querySelector('.carousel-current');

            if (container) {
                // 1. Lazy-On-Demand: Загрузка скрытых фото только при наведении или свайпе
                const loadGalleryImages = () => {
                    const lazyImages = carousel.querySelectorAll('.lazy-gallery-img[data-src]');
                    lazyImages.forEach(img => {
                        img.src = img.getAttribute('data-src');
                        img.removeAttribute('data-src');
                    });
                };
                
                // IntersectionObserver: начинаем загружать фото как только карточка входит в зону видимости
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            // Мгновенная загрузка при появлении в области видимости (с большим rootMargin)
                            loadGalleryImages();
                            observer.unobserve(entry.target);
                        }
                    });
                }, {
                    threshold: 0.1,
                    rootMargin: '0px 0px 500px 0px'
                });
                observer.observe(carousel);

                // Резервные триггеры — МГНОВЕННАЯ загрузка если пользователь взаимодействует
                carousel.addEventListener('mouseenter', loadGalleryImages, { once: true });
                carousel.addEventListener('touchstart', loadGalleryImages, { once: true, passive: true });

                // 2. Обновление счетчика при скролле (пальцем или кнопкой)
                if (currentCounter) {
                    container.addEventListener('scroll', () => {
                        loadGalleryImages(); // Свайп = мгновенная загрузка
                        const index = Math.round(container.scrollLeft / container.clientWidth) + 1;
                        currentCounter.textContent = index;
                    }, { passive: true });
                }

                // 3. Логика кнопок (с зацикливанием + мгновенная загрузка)
                if (prevBtn && nextBtn) {
                    const newPrev = prevBtn.cloneNode(true);
                    const newNext = nextBtn.cloneNode(true);
                    prevBtn.replaceWith(newPrev);
                    nextBtn.replaceWith(newNext);

                    newPrev.addEventListener('click', (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        loadGalleryImages(); // ← Мгновенно при клике на стрелку
                        if (container.scrollLeft <= 5) {
                            container.scrollTo({ left: container.scrollWidth, behavior: 'smooth' });
                        } else {
                            container.scrollBy({ left: -container.clientWidth, behavior: 'smooth' });
                        }
                    });

                    newNext.addEventListener('click', (e) => {
                        e.preventDefault();
                        e.stopPropagation();
                        loadGalleryImages(); // ← Мгновенно при клике на стрелку
                        if (container.scrollLeft + container.clientWidth >= container.scrollWidth - 5) {
                            container.scrollTo({ left: 0, behavior: 'smooth' });
                        } else {
                            container.scrollBy({ left: container.clientWidth, behavior: 'smooth' });
                        }
                    });
                }
            }
        });
    }

    // Initialize on first load
    initCarousels();
    // Re-initialize if using View Transitions
    document.addEventListener('astro:after-swap', initCarousels);
</script>
