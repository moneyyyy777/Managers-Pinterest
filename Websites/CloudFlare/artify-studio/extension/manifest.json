{
  "manifest_version": 3,
  "name": "Artify Studio — Creative Fabrica Clipper",
  "version": "1.0.0",
  "description": "Точечный и быстрый сбор товаров с Creative Fabrica напрямую в подборки Artify Studio (черновики и полный парсинг).",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://*.creativefabrica.com/*",
    "https://creativefabrica.com/*",
    "http://localhost:3333/*",
    "http://127.0.0.1:3333/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Artify Studio — Панель клипера",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.creativefabrica.com/*",
        "https://creativefabrica.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background/background.js"
  }
}
