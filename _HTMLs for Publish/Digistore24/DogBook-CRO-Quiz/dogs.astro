        grid.appendChild(row);
      });
    }

    let exitModalFired = false;
    function openModal() {
      if (exitModalFired) return;
      exitModalFired = true;
      document.getElementById('exitModal').classList.add('open');
    }
    function closeModal() {
      document.getElementById('exitModal').classList.remove('open');
    }

    document.getElementById('modalCloseBtn')?.addEventListener('click', closeModal);
    document.getElementById('modalDismissBtn')?.addEventListener('click', closeModal);

    document.addEventListener('mouseleave', (e) => {
      if (e.clientY <= 15 && !exitModalFired) openModal();
    });

    window.addEventListener('load', () => {
      try { window.history.pushState({ page: 'quiz-start' }, ''); } catch (err) {}
    });

    window.addEventListener('popstate', () => {
      if (!exitModalFired) {
        openModal();
        try { window.history.pushState(null, '', window.location.href); } catch (err) {}
      }
    });

    document.getElementById('exitForm')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = document.getElementById('leadEmail').value;
      if (!email) return;

      e.target.innerHTML = `
        <div style="background:#ecfdf5; border:1px solid #a7f3d0; padding:12px; border-radius:10px; color:#065f46; font-size:13px; font-weight:700; text-align:center;">
          ✓ Success! Check your inbox in 2 minutes for the PDF.
        </div>
      `;

      setTimeout(() => {
        closeModal();
        const route = userAnswers.route || 'potty';
        let targetUrl = CONFIG.DIGISTORE_OFFERS[route] || CONFIG.DIGISTORE_OFFERS.default;
        targetUrl = targetUrl.replace('AFFILIATE_ID', CONFIG.AFFILIATE_ID);
        window.location.href = targetUrl;
      }, 1500);
    });
  </script>
