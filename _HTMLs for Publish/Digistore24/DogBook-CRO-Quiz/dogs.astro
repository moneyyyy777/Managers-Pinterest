        ],
        training: [
          { name: "Rabbitgoo Ergonomic No-Pull Front-Clip Dog Harness", tag: "Instantly ends choking and heavy arm pulling", badge: "Over 160k Reviews", keyword: "no+pull+dog+harness" },
