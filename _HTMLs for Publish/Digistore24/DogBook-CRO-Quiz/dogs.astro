        ]
      }
    };

    const userAnswers = { route: 'potty', age: 'puppy', duration: 'new' };

    // Event Delegation
    document.querySelectorAll('#step1 .quiz-option').forEach(btn => {
      btn.addEventListener('click', () => {
        userAnswers.route = btn.getAttribute('data-route');
        goToStep(2);
      });
    });

    document.querySelectorAll('#step2 .quiz-option').forEach(btn => {
      btn.addEventListener('click', () => {
        userAnswers.age = btn.getAttribute('data-age');
        goToStep(3);
      });
    });

    document.querySelectorAll('#step3 .quiz-option').forEach(btn => {
      btn.addEventListener('click', () => {
        userAnswers.duration = btn.getAttribute('data-dur');
        runAnalysis();
      });
    });

    function goToStep(nextStep) {
      document.querySelectorAll('.step-screen').forEach(el => el.classList.remove('active'));
      const nextEl = document.getElementById('step' + nextStep);
      if (nextEl) nextEl.classList.add('active');

      const fill = document.getElementById('progressFill');
      const pText = document.getElementById('progressText');
      const pPercent = document.getElementById('percentText');

      if (nextStep === 2) {
        fill.style.width = '66.66%';
        pText.innerText = 'Question 2 of 3';
        pPercent.innerText = '66% Completed';
      } else if (nextStep === 3) {
        fill.style.width = '100%';
        pText.innerText = 'Question 3 of 3';
        pPercent.innerText = 'Almost Finished';
      }
    }

    function runAnalysis() {
      document.querySelectorAll('.step-screen').forEach(el => el.classList.remove('active'));
      document.getElementById('stepLoading').classList.add('active');

      const loadingText = document.getElementById('loadingText');
      const messages = [
        "Analyzing behavioral indicators...",
        "Evaluating " + userAnswers.age + " neuro-development factors...",
        "Formulating 7-day correction protocol..."
      ];

      let msgIndex = 0;
      const interval = setInterval(() => {
        msgIndex++;
        if (msgIndex < messages.length) loadingText.innerText = messages[msgIndex];
      }, 400);

      setTimeout(() => {
        clearInterval(interval);
        displayResults();
      }, 1250);
    }

    function displayResults() {
      document.querySelectorAll('.step-screen').forEach(el => el.classList.remove('active'));
      document.getElementById('progressSection').style.display = 'none';
      document.getElementById('stepResults').classList.add('active');
      document.getElementById('quizCard').scrollIntoView({ behavior: 'smooth', block: 'start' });

      const route = userAnswers.route || 'potty';
      const ctaLink = document.getElementById('primaryCtaLink');

      let targetUrl = CONFIG.DIGISTORE_OFFERS[route] || CONFIG.DIGISTORE_OFFERS.default;
      targetUrl = targetUrl.replace('AFFILIATE_ID', CONFIG.AFFILIATE_ID);
      ctaLink.href = targetUrl;

      if (route === 'potty') {
        document.getElementById('pageMainHeading').innerHTML = "Your Custom <span>Potty &amp; Housebreaking</span> Action Plan";
        document.getElementById('offerTitle').innerText = "The 7-Day Rapid Housebreaking & Potty Miracle";
        document.getElementById('offerSummary').innerText = "Step-by-step masterplan to stop carpet puddles, crate accidents, and middle-of-the-night cries once and for all.";
        document.getElementById('offerBullets').innerHTML = `
          <li class="bullet-item"><svg viewBox="0 0 20 20"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/></svg><span>Stops indoor accidents in 3 to 7 days flat</span></li>
          <li class="bullet-item"><svg viewBox="0 0 20 20"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/></svg><span>Printable 24-hour hour-by-hour puppy bathroom schedule</span></li>
          <li class="bullet-item"><svg viewBox="0 0 20 20"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/></svg><span>Eliminates pheromone attraction so they stop re-soiling the same spot</span></li>
        `;
        document.getElementById('ctaBtnText').innerHTML = "Get The 7-Day Potty Miracle &rarr;";
      } else if (route === 'apartment') {
        document.getElementById('pageMainHeading').innerHTML = "Your Custom <span>Apartment Calm &amp; Anti-Bark</span> Action Plan";
        document.getElementById('offerTitle').innerText = "Apartment Calm & Separation Anxiety Mastery";
        document.getElementById('offerSummary').innerText = "End hallway barking, door chewing, and lonely howling before your landlord issues a noise notice.";
        document.getElementById('offerBullets').innerHTML = `
          <li class="bullet-item"><svg viewBox="0 0 20 20"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/></svg><span>The 'Silent Departure' routine: leave home without whining or panic</span></li>
          <li class="bullet-item"><svg viewBox="0 0 20 20"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/></svg><span>Desensitize trigger noises: doorbells, elevator footsteps &amp; sirens</span></li>
          <li class="bullet-item"><svg viewBox="0 0 20 20"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/></svg><span>High-rise &amp; balcony bathroom hacks to avoid 3am elevator trips</span></li>
        `;
        document.getElementById('ctaBtnText').innerHTML = "End Apartment Barking Now &rarr;";
      } else if (route === 'training') {
        document.getElementById('pageMainHeading').innerHTML = "Your Custom <span>Leash &amp; Obedience Mastery</span> Plan";
        document.getElementById('offerTitle').innerText = "Brain Training & Loose-Leash Walking Protocol";
        document.getElementById('offerSummary').innerText = "Transform pulling, puppy biting, and selective hearing into calm, joyful focus on every single walk.";
        document.getElementById('offerBullets').innerHTML = `
          <li class="bullet-item"><svg viewBox="0 0 20 20"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/></svg><span>The 'Gentle Brake' method: walk with a completely loose leash</span></li>
          <li class="bullet-item"><svg viewBox="0 0 20 20"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/></svg><span>Emergency recall command that snaps your dog's attention back 100%</span></li>
          <li class="bullet-item"><svg viewBox="0 0 20 20"><path d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"/></svg><span>Stop puppy mouthing and ankle biting with positive redirection</span></li>
        `;
        document.getElementById('ctaBtnText').innerHTML = "Get The Obedience Blueprint &rarr;";
      }

      const products = CONFIG.AMAZON_MATRIX[route] || CONFIG.AMAZON_MATRIX.potty;
      const grid = document.getElementById('amazonProductsGrid');
      grid.innerHTML = '';

      products.forEach(p => {
        const amazonUrl = `https://www.amazon.com/s?k=${p.keyword}&tag=${CONFIG.AMAZON_TAG}`;
        const row = document.createElement('a');
        row.className = 'product-row';
        row.href = amazonUrl;
        row.target = '_blank';
        row.rel = 'noopener noreferrer';
        row.innerHTML = `
          <div class="prod-details">
            <span class="prod-name">${p.name}</span>
            <span class="prod-tag">★ ${p.tag}</span>
